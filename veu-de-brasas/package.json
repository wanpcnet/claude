{
  "name": "veu-de-brasas",
  "private": true,
  "version": "1.0.0",
  "description": "Véu de Brasas — ação 2D top-down de sobrevivência arcana (PixiJS 8 + WebGL)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "art": "node scripts/art2/build_all.mjs",
    "fx": "VEU_FX_SOFT=1 node scripts/art2/build_all.mjs fx",
    "env": "node scripts/assets/build_kaykit_env.mjs",
    "ground": "python3 scripts/assets/ground_kaykit.py",
    "keyart": "node scripts/assets/render_scene.mjs scripts/assets/keyart.json",
    "kaykit:fetch": "python3 scripts/assets/fetch_kaykit.py",
    "chars": "node scripts/assets/build_kaykit.mjs",
    "audio": "python3 scripts/audio/build_audio.py",
    "e2e": "node scripts/e2e/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.2.0",
    "@fontsource/cinzel": "^5.2.0",
    "pixi-filters": "^6.1.0",
    "pixi.js": "^8.10.0"
  },
  "devDependencies": {
    "three": "^0.169.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
