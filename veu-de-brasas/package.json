{
  "name": "veu-de-brasas",
  "private": true,
  "version": "1.0.0",
  "description": "Véu de Brasas — ação 2D top-down de sobrevivência arcana (PixiJS 8 + WebGL)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "art": "node scripts/art2/build_all.mjs",
    "ground": "python3 scripts/assets/ground_cc0.py",
    "props": "node scripts/assets/props_cc0.mjs",
    "assets:sov": "python3 scripts/assets/build_sov.py",
    "audio": "python3 scripts/audio/build_audio.py",
    "e2e": "node scripts/e2e/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.2.0",
    "@fontsource/cinzel": "^5.2.0",
    "pixi-filters": "^6.1.0",
    "pixi.js": "^8.10.0"
  },
  "devDependencies": {
    "three": "^0.169.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
